#pragma once
// =======================================================================
// CYD28 Plane Spotter — Configuration
// =======================================================================
// Copy this file to src/config.env and fill in your values.
// This file is #include'd by main.cpp — keep it as valid C preprocessor!
// Anything you leave out falls back to the defaults in main.cpp.
// This file is optional: without WiFi credentials the device starts a setup
// portal ("PlaneSpotter-Setup") where you pick the network from your phone.

#define WIFI_SSID "yourWifiId"   // leave as is to use the setup portal instead
#define WIFI_PASS "yourPassword"

// No API keys needed: aircraft come from airplanes.live (adsb.lol / adsb.fi as
// fallbacks), routes and aircraft models from adsbdb.com,
// weather from Open-Meteo.

// 1 = miles / Fahrenheit / mph,  0 = kilometres / Celsius / km/h
// (aircraft speed is always in knots, altitude always in feet)
#define UNITS_IMPERIAL 1

// POSIX TZ string. US Central: "CST6CDT,M3.2.0,M11.1.0"
// US Eastern: "EST5EDT,M3.2.0,M11.1.0"   Central Europe: "CET-1CEST,M3.5.0,M10.5.0/3"
#define TIMEZONE "CST6CDT,M3.2.0,M11.1.0"

#define UPDATE_INTERVAL_MS  10000   // aircraft poll (airplanes.live allows ~1 req/s)
#define WEATHER_INTERVAL_MS 600000

// Runtime-configurable location & radar (persisted via NVS)
// Defaults below; overridden by the web UI and saved to flash.
#define DEFAULT_HOME_NAME         "Lombard, Illinois"
#define DEFAULT_HOME_LAT          41.8800
#define DEFAULT_HOME_LON         -88.0078
#define DEFAULT_SEARCH_RADIUS_NM  25      // API query radius, nautical miles (max 250)
#define DEFAULT_RADAR_RANGE       30      // radar scope radius, in mi (or km if metric)
